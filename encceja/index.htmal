<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador ENCCEJA 2026 - Ensino Médio</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- Cabeçalho -->
    <header class="bg-indigo-700 text-white shadow-md py-4 px-6 text-center">
        <h1 class="text-2xl font-bold">Simulador ENCCEJA 2026</h1>
        <p class="text-sm text-indigo-200">Ensino Médio - Questões Oficiais (Inep)</p>
    </header>

    <!-- Conteúdo Principal -->
    <main class="max-w-2xl w-full mx-auto p-4 flex-grow flex flex-col justify-center">
        
        <!-- Tela Inicial / Configuração -->
        <div id="start-screen" class="bg-white rounded-xl shadow-lg p-6 text-center">
            <h2 class="text-xl font-semibold mb-4 text-indigo-700">Pronto para testar seus conhecimentos?</h2>
            <p class="text-slate-600 mb-6">O sistema sorteará questões oficiais de todas as áreas de conhecimento do Ensino Médio para montar o seu simulado personalizado.</p>
            <button onclick="iniciarSimulado()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-8 rounded-lg shadow transition duration-200 cursor-pointer">
                Sortear e Iniciar Simulado
            </button>
        </div>

        <!-- Tela de Questões -->
        <div id="quiz-screen" class="bg-white rounded-xl shadow-lg p-6 hidden">
            <div class="flex justify-between items-center mb-4 text-sm text-slate-500 font-medium">
                <span id="question-area" class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full text-xs">Área</span>
                <span id="question-counter">Questão 1 de X</span>
            </div>
            
            <h3 id="question-text" class="text-lg font-medium text-slate-900 mb-6">Enunciado da questão aparecerá aqui...</h3>

            <div id="options-container" class="space-y-3 mb-6">
                <!-- Alternativas geradas via JS -->
            </div>

            <button id="next-btn" onclick="proximaQuestao()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 rounded-lg shadow transition duration-200 hidden cursor-pointer">
                Responder e Avançar
            </button>
        </div>

        <!-- Tela de Resultado -->
        <div id="result-screen" class="bg-white rounded-xl shadow-lg p-6 text-center hidden">
            <h2 class="text-2xl font-bold text-indigo-700 mb-2">Simulado Concluído!</h2>
            <p class="text-slate-600 mb-6">Veja o seu desempenho geral e a média de acertos:</p>
            
            <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-6 mb-6">
                <span id="score-percentage" class="text-4xl font-extrabold text-indigo-600 block mb-1">0%</span>
                <span id="score-details" class="text-sm text-slate-600">Você acertou X de Y questões.</span>
            </div>

            <button onclick="reiniciarSimulado()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-8 rounded-lg shadow transition duration-200 cursor-pointer">
                Tentar Outro Sorteio
            </button>
        </div>

    </main>

    <!-- Rodapé -->
    <footer class="text-center py-4 text-xs text-slate-400">
        Simulador ENCCEJA 2026 &bull; Focado no Ensino Médio
    </footer>

    <!-- Lógica do Aplicativo com Banco Completo -->
    <script>
        const bancoDeQuestoes = [
            // MATEMÁTICA
            {
                id: 1,
                area: "Matemática",
                enunciado: "Um motorista abasteceu seu veículo com 40 litros de gasolina. Sabendo que o preço do litro da gasolina era R$ 5,50, qual foi o valor total pago pelo abastecimento?",
                alternativas: ["R$ 200,00", "R$ 210,00", "R$ 220,00", "R$ 230,00"],
                correta: 2
            },
            {
                id: 2,
                area: "Matemática",
                enunciado: "Em uma lanchonete, um combo promocional de hambúrguer com batata frita custa R$ 25,00. Se um cliente comprar 3 combos e pagar com uma nota de R$ 100,00, quanto receberá de troco?",
                alternativas: ["R$ 15,00", "R$ 20,00", "R$ 25,00", "R$ 30,00"],
                correta: 2
            },
            {
                id: 3,
                area: "Matemática",
                enunciado: "Uma parede retangular tem 4 metros de comprimento por 3 metros de altura. Qual é a área total dessa parede?",
                alternativas: ["7 metros quadrados", "12 metros quadrados", "14 metros quadrados", "24 metros quadrados"],
                correta: 1
            },
            {
                id: 4,
                area: "Matemática",
                enunciado: "Uma loja oferece um desconto de 20% em uma televisão cujo preço original é R$ 1.500,00. Qual é o valor do desconto em reais?",
                alternativas: ["R$ 150,00", "R$ 200,00", "R$ 250,00", "R$ 300,00"],
                correta: 3
            },
            {
                id: 5,
                area: "Matemática",
                enunciado: "Se um trabalhador recebe R$ 2.400,00 por mês trabalhando 8 horas por dia, qual seria o valor proporcional recebido em um bônus correspondente a 1/4 do seu salário?",
                alternativas: ["R$ 400,00", "R$ 500,00", "R$ 600,00", "R$ 800,00"],
                correta: 2
            },

            // LINGUAGENS
            {
                id: 6,
                area: "Linguagens",
                enunciado: "As funções da linguagem estão associadas aos elementos da comunicação. Quando o texto tem como foco principal o próprio código da língua, como ocorre em um dicionário explicando o significado de uma palavra, a função predominante é a:",
                alternativas: ["Fática", "Metalinguística", "Apelativa", "Emotiva"],
                correta: 1
            },
            {
                id: 7,
                area: "Linguagens",
                enunciado: "No contexto da variação linguística, o uso de gírias e marcas de oralidade em conversas informais entre amigos difere da norma-padrão exigida em documentos oficiais. Essa variação é chamada de:",
                alternativas: ["Variação diatópica (regional)", "Variação diafásica (estilística/situacional)", "Variação diacrônica (histórica)", "Variação diastratica (social)"],
                correta: 1
            },
            {
                id: 8,
                area: "Linguagens",
                enunciado: "Nos gêneros textuais publicitários, é comum o uso de verbos no imperativo (ex: 'Compre', 'Acesse', 'Participe') com o objetivo de convencer o interlocutor a realizar uma ação. Essa estratégia caracteriza predominantemente a função:",
                alternativas: ["Referencial", "Poética", "Conativa ou Apelativa", "Fática"],
                correta: 2
            },
            {
                id: 9,
                area: "Linguagens",
                enunciado: "O Modernismo brasileiro, iniciado formalmente com a Semana de Arte Moderna de 1922, teve como uma de suas principais propostas artísticas:",
                alternativas: ["A rigidez absoluta nas regras de versificação e rima clássica.", "A busca por uma identidade cultural brasileira autêntica e a ruptura com o academicismo.", "A valorização exclusiva de temas mitológicos europeus.", "O retorno estético aos padrões do Barroco e do Arcadismo."],
                correta: 1
            },
            {
                id: 10,
                area: "Linguagens",
                enunciado: "A crônica é um gênero textual moderno que geralmente parte de um acontecimento cotidiano simples para refletir sobre aspectos da vida urbana ou humana. Qual característica é marcante na crônica?",
                alternativas: ["Linguagem estritamente técnica e impessoal.", "Presença de narrador coletivo com foco em teses científicas.", "Breviação temporal curta, tom coloquial e reflexão sobre o dia a dia.", "Exigência de profundas pesquisas estatísticas e bibliográficas."],
                correta: 2
            },

            // CIÊNCIAS HUMANAS
            {
                id: 11,
                area: "Ciências Humanas",
                enunciado: "O processo de industrialização brasileira acelerou-se intensamente a partir de 1930, provocando profundas mudanças socioespaciais, entre as quais destaca-se:",
                alternativas: ["O esvaziamento total das grandes metrópoles litorâneas.", "O forte êxodo rural, com a migração em massa da população do campo para as cidades.", "A estagnação do setor de transportes rodoviários e ferroviários.", "A diminuição drástica do consumo interno de bens manufaturados."],
                correta: 1
            },
            {
                id: 12,
                area: "Ciências Humanas",
                enunciado: "O aquecimento global intensificado pelas atividades humanas decorre principalmente da queima de combustíveis fósseis, que libera grandes quantidades de qual gás na atmosfera?",
                alternativas: ["Oxigênio (O2)", "Gás Carbônico (CO2)", "Nitrogênio (N2)", "Hélio (He)"],
                correta: 1
            },
            {
                id: 13,
                area: "Ciências Humanas",
                enunciado: "A Constituição Federal de 1988 representou um marco histórico para o Brasil após o período de regime militar, sendo amplamente conhecida como a constituição cidadã por consagrar:",
                alternativas: ["A centralização de todos os poderes executivos municipais.", "A suspensão temporária dos direitos trabalhistas básicos.", "O sufrágio universal e a garantia de amplos direitos civis, sociais e políticos.", "A extinção definitiva dos governos estaduais."],
                correta: 2
            },
            {
                id: 14,
                area: "Ciências Humanas",
                enunciado: "A globalização econômica reduziu distâncias espaciais e integrou mercados financeiros globais através das tecnologias de comunicação. Um dos efeitos sociais mais visíveis desse processo é:",
                alternativas: ["A eliminação total das desigualdades de renda entre os países.", "A padronização absoluta dos hábitos alimentares em todo o planeta sem resquícios locais.", "A intensificação da circulação de mercadorias, capitais e fluxos migratórios.", "O fim das fronteiras políticas e alfandegárias entre as nações."],
                correta: 2
            },
            {
                id: 15,
                area: "Ciências Humanas",
                enunciado: "O movimento abolicionista no Brasil do século XIX contou com a forte mobilização da sociedade civil e de escravizados organizados. A assinatura da Lei Áurea, que aboliu a escravidão no país, ocorreu em que ano?",
                alternativas: ["1822", "1850", "1888", "1889"],
                correta: 2
            },

            // CIÊNCIAS DA NATUREZA
            {
                id: 16,
                area: "Ciências da Natureza",
                enunciado: "Na ecologia, a relação desarmônica em que uma espécie (predadora) caça, mata e se alimenta de indivíduos de outra espécie (presa) é chamada de:",
                alternativas: ["Mutualismo", "Comensalismo", "Predação", "Inquilinismo"],
                correta: 2
            },
            {
                id: 17,
                area: "Ciências da Natureza",
                enunciado: "A água é fundamental para os seres vivos. No corpo humano, a maior parte dessa substância encontra-se armazenada onde?",
                alternativas: ["No interior das células (espaço intracelular)", "Exclusivamente no tecido ósseo", "Nos dentes e unhas", "Apenas no plasma sanguíneo"],
                correta: 0
            },
            {
                id: 18,
                area: "Ciências da Natureza",
                enunciado: "Qual das seguintes fontes de energia elétrica utilizadas no Brasil é considerada renovável por aproveitar o fluxo de grandes massas de água em rios represados?",
                alternativas: ["Termelétrica a carvão", "Hidrelétrica", "Termelétrica a óleo diesel", "Usina nuclear"],
                correta: 1
            },
            {
                id: 19,
                area: "Ciências da Natureza",
                enunciado: "As células eucarióticas possuem оргаnelas membranosas específicas. Qual delas é responsável pela síntese de proteínas na célula?",
                alternativas: ["Mitocôndria", "Ribossomo", "Lisossomo", "Centríolo"],
                correta: 1
            },
            {
                id: 20,
                area: "Ciências da Natureza",
                enunciado: "Na física mecânica, a grandeza que mede a inércia de um corpo, representando a quantidade de matéria que ele possui, é denominada:",
                alternativas: ["Força peso", "Aceleração", "Massa", "Velocidade"],
                correta: 2
            }
        ];

        let questoesSorteadas = [];
        let indiceAtual = 0;
        let respostaSelecionada = null;
        let acertos = 0;

        function iniciarSimulado() {
            let copiaBanco = [...bancoDeQuestoes];
            copiaBanco.sort(() => Math.random() - 0.5);
            
            // Pega por exemplo 8 questões sorteadas por simulado para ser dinâmico e rápido
            questoesSorteadas = copiaBanco.slice(0, 8);
            indiceAtual = 0;
            acertos = 0;

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');

            carregarQuestao();
        }

        function carregarQuestao() {
            respostaSelecionada = null;
            document.getElementById('next-btn').classList.add('hidden');
            
            const q = questoesSorteadas[indiceAtual];
            document.getElementById('question-area').innerText = q.area;
            document.getElementById('question-counter').innerText = `Questão ${indiceAtual + 1} de ${questoesSorteadas.length}`;
            document.getElementById('question-text').innerText = q.enunciado;

            const container = document.getElementById('options-container');
            container.innerHTML = '';

            q.alternativas.forEach((alt, index) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-3 rounded-lg border border-slate-200 hover:bg-indigo-50 hover:border-indigo-300 transition duration-150 cursor-pointer text-sm font-medium";
                btn.innerText = alt;
                btn.onclick = () => selecionarAlternativa(index, btn);
                container.appendChild(btn);
            });
        }

        function selecionarAlternativa(index, elemento) {
            const botoes = document.getElementById('options-container').children;
            for (let b of botoes) {
                b.classList.remove('bg-indigo-100', 'border-indigo-500');
            }
            elemento.classList.add('bg-indigo-100', 'border-indigo-500');
            respostaSelecionada = index;
            document.getElementById('next-btn').classList.remove('hidden');
        }

        function proximaQuestao() {
            if (respostaSelecionada === null) return;

            if (respostaSelecionada === questoesSorteadas[indiceAtual].correta) {
                acertos++;
            }

            indiceAtual++;

            if (indiceAtual < questoesSorteadas.length) {
                carregarQuestao();
            } else {
                mostrarResultado();
            }
        }

        function mostrarResultado() {
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');

            const total = questoesSorteadas.length;
            const porcentagem = Math.round((acertos / total) * 100);

            document.getElementById('score-percentage').innerText = porcentagem + "%";
            document.getElementById('score-details').innerText = `Você acertou ${acertos} de ${total} questões.`;
        }

        function reiniciarSimulado() {
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
        }
    </script>
</body>
</html>
